{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // React Native 0.87 makes the Strict TypeScript API the default. Opting in
    // here keeps this package compiling against the surface consumers will
    // actually have, rather than the legacy types that go away after 0.88.
    "customConditions": ["react-native", "react-native-strict-api"],
    "lib": ["ESNext", "DOM"],
    "jsx": "react-jsx",
    "outDir": "build",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src"],
  "exclude": ["src/**/__tests__/**", "build", "example"]
}
